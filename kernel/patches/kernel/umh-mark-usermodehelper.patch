--- a/kernel/umh.c
+++ b/kernel/umh.c
@@ -31,6 +31,18 @@
 
 #include <trace/events/module.h>
 
+#ifdef CONFIG_SECURITY_PKM
+/*
+ * KACS applies a PeiosTcb floor to kernel-initiated execs: the kernel spawns
+ * these on its own behalf and at full privilege, so the binary it lands on must
+ * be TCB-signed. Nothing upstream identifies such an exec by the time the LSM
+ * sees it -- the child is created by user_mode_thread() and so never carries
+ * PF_KTHREAD, and security_kernel_module_request() fires in the *requesting*
+ * task, before this one exists. Mark the child here, where it is unambiguous.
+ */
+extern void pkm_kacs_mark_usermodehelper(void);
+#endif
+
 static kernel_cap_t usermodehelper_bset = CAP_FULL_SET;
 static kernel_cap_t usermodehelper_inheritable = CAP_FULL_SET;
 static DEFINE_SPINLOCK(umh_sysctl_lock);
@@ -105,6 +117,15 @@
 
 	commit_creds(new);
 
+#ifdef CONFIG_SECURITY_PKM
+	/*
+	 * After commit_creds() so the mark cannot be lost with an abandoned
+	 * cred, and before kernel_execve() so it is in place when KACS runs its
+	 * bprm hooks for this exec.
+	 */
+	pkm_kacs_mark_usermodehelper();
+#endif
+
 	wait_for_initramfs();
 	retval = kernel_execve(sub_info->path,
 			       (const char *const *)sub_info->argv,
