diff --git a/kernel/nsproxy.c b/kernel/nsproxy.c
--- a/kernel/nsproxy.c
+++ b/kernel/nsproxy.c
@@ -30,6 +30,23 @@
 
 static struct kmem_cache *nsproxy_cachep;
 
+#define NSPROXY_NAMESPACE_FLAGS (CLONE_NEWNS | CLONE_NEWUTS | CLONE_NEWIPC | \
+				 CLONE_NEWPID | CLONE_NEWNET | CLONE_NEWCGROUP | \
+				 CLONE_NEWTIME)
+
+/*
+ * KACS: a private mount table is an object its creator owns (see
+ * <linux/kacs_mntns.h>), so asking for one -- and nothing else -- needs no
+ * capability. Every other namespace type keeps the CAP_SYS_ADMIN gate, which
+ * the KACS switchboard answers with SeTcbPrivilege whatever user namespace
+ * the caller sits in.
+ */
+static bool only_mount_namespace_requested(u64 flags)
+{
+	return IS_ENABLED(CONFIG_SECURITY_PKM) &&
+	       (flags & NSPROXY_NAMESPACE_FLAGS) == CLONE_NEWNS;
+}
+
 struct nsproxy init_nsproxy = {
 	.count			= REFCOUNT_INIT(1),
 	.uts_ns			= &init_uts_ns,
@@ -178,7 +195,8 @@ int copy_namespaces(u64 flags, struct task_struct *tsk)
 			get_nsproxy(old_ns);
 			return 0;
 		}
-	} else if (!ns_capable(user_ns, CAP_SYS_ADMIN))
+	} else if (!only_mount_namespace_requested(flags) &&
+		   !ns_capable(user_ns, CAP_SYS_ADMIN))
 		return -EPERM;
 
 	/*
@@ -220,7 +238,8 @@ int unshare_nsproxy_namespaces(unsigned long unshare_flags,
 		return 0;
 
 	user_ns = new_cred ? new_cred->user_ns : current_user_ns();
-	if (!ns_capable(user_ns, CAP_SYS_ADMIN))
+	if (!only_mount_namespace_requested(unshare_flags) &&
+	    !ns_capable(user_ns, CAP_SYS_ADMIN))
 		return -EPERM;
 
 	*new_nsp = create_new_namespaces(unshare_flags, current, user_ns,
