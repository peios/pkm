diff --git a/init/do_mounts.c b/init/do_mounts.c
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -512,6 +512,20 @@ struct file_system_type rootfs_fs_type =
 
 void __init init_rootfs(void)
 {
+#ifdef CONFIG_SECURITY_PKM
+	/*
+	 * Always a tmpfs, whatever root= or rootfstype= say. KACS seeds the
+	 * rootfs root's security descriptor as an xattr for everything the
+	 * initramfs creates to inherit, and ramfs stores no xattrs: StrataFS
+	 * then refuses every view the initramfs mounts over it, because it
+	 * never synthesises a missing descriptor. An installed system always
+	 * passes root=, which upstream takes as a reason to use ramfs.
+	 */
+	if (IS_ENABLED(CONFIG_TMPFS)) {
+		is_tmpfs = true;
+		return;
+	}
+#endif
 	if (IS_ENABLED(CONFIG_TMPFS)) {
 		if (!saved_root_name[0] && !root_fs_names)
 			is_tmpfs = true;
