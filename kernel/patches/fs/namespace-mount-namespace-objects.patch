 		return true;
 #endif
 	return ns_capable(current->nsproxy->mnt_ns->user_ns, CAP_SYS_ADMIN);
 }
 
+bool may_mount(void)
+{
+	return may_mount_op(PKM_KACS_MNTNS_OP_OTHER);
+}
+
+/*
+ * The one mount(2) shape a namespace descriptor can admit: a bind, with or
+ * without MS_REC. MS_REMOUNT|MS_BIND is a per-mount reconfigure, and the
+ * dispatch below sends it elsewhere.
+ */
+static unsigned int mount_op_for_flags(unsigned long flags)
+{
+	if ((flags & MS_BIND) && !(flags & MS_REMOUNT))
+		return PKM_KACS_MNTNS_OP_BIND;
+	return PKM_KACS_MNTNS_OP_OTHER;
+}
